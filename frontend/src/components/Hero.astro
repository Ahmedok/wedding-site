---
import { SITE_CONFIG } from '../config';
import Countdown from './Countdown.astro';
---

<section class="hero" id="hero">
  <div class="hero__bg">
    <svg class="hero__pattern" viewBox="0 0 800 600" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice">
      <defs>
        <radialGradient id="heroGrad1" cx="30%" cy="30%" r="60%">
          <stop offset="0%" stop-color="hsl(270, 50%, 35%)" />
          <stop offset="100%" stop-color="hsl(270, 50%, 15%)" />
        </radialGradient>
        <radialGradient id="heroGrad2" cx="70%" cy="60%" r="50%">
          <stop offset="0%" stop-color="hsl(25, 80%, 50%)" stop-opacity="0.3" />
          <stop offset="100%" stop-color="hsl(25, 80%, 50%)" stop-opacity="0" />
        </radialGradient>
        <!-- Floral petal pattern -->
        <pattern id="floralBg" x="0" y="0" width="120" height="120" patternUnits="userSpaceOnUse">
          <!-- Center flower -->
          <circle cx="60" cy="60" r="4" fill="rgba(237,131,36,0.15)" />
          <ellipse cx="60" cy="45" rx="6" ry="14" fill="rgba(255,255,255,0.06)" transform="rotate(0,60,60)" />
          <ellipse cx="60" cy="45" rx="6" ry="14" fill="rgba(255,255,255,0.06)" transform="rotate(60,60,60)" />
          <ellipse cx="60" cy="45" rx="6" ry="14" fill="rgba(255,255,255,0.06)" transform="rotate(120,60,60)" />
          <ellipse cx="60" cy="45" rx="6" ry="14" fill="rgba(255,255,255,0.06)" transform="rotate(180,60,60)" />
          <ellipse cx="60" cy="45" rx="6" ry="14" fill="rgba(255,255,255,0.06)" transform="rotate(240,60,60)" />
          <ellipse cx="60" cy="45" rx="6" ry="14" fill="rgba(255,255,255,0.06)" transform="rotate(300,60,60)" />
          <!-- Corner dots -->
          <circle cx="0" cy="0" r="2" fill="rgba(255,255,255,0.08)" />
          <circle cx="120" cy="0" r="2" fill="rgba(255,255,255,0.08)" />
          <circle cx="0" cy="120" r="2" fill="rgba(255,255,255,0.08)" />
          <circle cx="120" cy="120" r="2" fill="rgba(255,255,255,0.08)" />
          <!-- Curved stems -->
          <path d="M 0 90 Q 30 80, 40 60" stroke="rgba(255,255,255,0.04)" stroke-width="1" fill="none" />
          <path d="M 120 30 Q 90 40, 80 60" stroke="rgba(255,255,255,0.04)" stroke-width="1" fill="none" />
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#heroGrad1)" />
      <rect width="100%" height="100%" fill="url(#heroGrad2)" />
      <rect width="100%" height="100%" fill="url(#floralBg)" />
      <!-- Large decorative circles -->
      <circle cx="15%" cy="20%" r="100" fill="rgba(255,255,255,0.03)" />
      <circle cx="85%" cy="75%" r="150" fill="rgba(237,131,36,0.05)" />
      <circle cx="50%" cy="50%" r="200" fill="none" stroke="rgba(255,255,255,0.03)" stroke-width="1" />
      <circle cx="50%" cy="50%" r="250" fill="none" stroke="rgba(255,255,255,0.02)" stroke-width="1" />
      <!-- Decorative arcs -->
      <path d="M 0 400 Q 200 300, 400 350 T 800 300" stroke="rgba(237,131,36,0.08)" stroke-width="2" fill="none" />
      <path d="M 0 450 Q 250 380, 500 400 T 800 350" stroke="rgba(255,255,255,0.04)" stroke-width="1" fill="none" />
    </svg>
  </div>
  <div class="hero__overlay"></div>
  <div class="hero__content container">
    <p class="hero__intro animate-fade-in-up">Приглашаем на свадьбу</p>
    <h1 class="hero__names animate-fade-in-up animate-delay-1">{SITE_CONFIG.coupleName}</h1>
    <div class="hero__divider animate-fade-in-up animate-delay-2">
      <svg width="200" height="20" viewBox="0 0 200 20" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M 0 10 Q 50 0, 100 10 T 200 10" stroke="rgba(237,131,36,0.8)" stroke-width="1.5" fill="none"/>
        <circle cx="100" cy="10" r="3" fill="hsl(25, 90%, 55%)" />
        <circle cx="85" cy="8" r="1.5" fill="rgba(255,255,255,0.6)" />
        <circle cx="115" cy="8" r="1.5" fill="rgba(255,255,255,0.6)" />
      </svg>
    </div>
    <p class="hero__date animate-fade-in-up animate-delay-3">5 сентября 2026</p>
    <p class="hero__venue animate-fade-in-up animate-delay-4">{SITE_CONFIG.venue.name}</p>

    <Countdown />
  </div>

  <div class="hero__scroll-indicator">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 5v14M5 12l7 7 7-7"/>
    </svg>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero__pattern {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (min-width: 768px) {
    .hero__bg {
      position: fixed;
      height: 100vh;
    }
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(60, 20, 80, 0.3) 0%,
      rgba(40, 15, 55, 0.2) 50%,
      rgba(30, 10, 45, 0.5) 100%
    );
    z-index: 1;
  }

  .hero__content {
    position: relative;
    z-index: 2;
    text-align: center;
    padding: 6rem 1.5rem 3rem;
    color: var(--color-white);
  }

  .hero__intro {
    font-family: var(--font-body);
    font-size: clamp(0.9rem, 2vw, 1.1rem);
    font-weight: 400;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    opacity: 0.9;
    margin-bottom: var(--space-md);
  }

  .hero__names {
    font-family: var(--font-heading);
    font-size: clamp(2.5rem, 8vw, 5rem);
    font-weight: 700;
    color: var(--color-white);
    line-height: 1.1;
    margin-bottom: var(--space-md);
    text-shadow: 0 2px 20px rgba(0, 0, 0, 0.3);
  }

  .hero__divider {
    margin-bottom: var(--space-lg);
    display: flex;
    justify-content: center;
  }

  .hero__date {
    font-family: var(--font-heading);
    font-size: clamp(1.2rem, 3vw, 1.8rem);
    font-weight: 400;
    letter-spacing: 0.05em;
    margin-bottom: var(--space-sm);
    color: rgba(255, 255, 255, 0.95);
  }

  .hero__venue {
    font-size: clamp(0.9rem, 2vw, 1.1rem);
    color: rgba(255, 255, 255, 0.8);
    margin-bottom: var(--space-2xl);
  }

  .hero__scroll-indicator {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    color: rgba(255, 255, 255, 0.6);
    animation: bounce 2s infinite;
  }

  @media (min-width: 768px) {
    .hero__content {
      padding: 8rem 2rem 4rem;
    }
  }
</style>
