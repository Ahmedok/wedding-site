<footer class="footer">
  <div class="container">
    <div class="footer__decoration">
      <svg width="60" height="30" viewBox="0 0 60 30" fill="none" xmlns="http://www.w3.org/2000/svg">
        <!-- Two hearts -->
        <path d="M15 18C15 18 8 14 8 10C8 7 10 6 12 7C14 8 15 10 15 10C15 10 16 8 18 7C20 6 22 7 22 10C22 14 15 18 15 18Z" fill="hsl(25, 90%, 55%)" opacity="0.6" />
        <path d="M45 18C45 18 38 14 38 10C38 7 40 6 42 7C44 8 45 10 45 10C45 10 46 8 48 7C50 6 52 7 52 10C52 14 45 18 45 18Z" fill="hsl(270, 50%, 60%)" opacity="0.5" />
        <path d="M22 14 Q 30 8, 38 14" stroke="hsl(270, 40%, 70%)" stroke-width="1" fill="none" opacity="0.4" />
      </svg>
    </div>
    <p class="footer__love">С любовью, Амина & Асылжан</p>
    <p class="footer__copy">&copy; 2026</p>
  </div>
</footer>

<style>
  .footer {
    background: linear-gradient(180deg, var(--color-bg), hsl(270, 30%, 94%));
    padding: var(--space-2xl) 0 var(--space-xl);
    text-align: center;
  }

  .footer__decoration {
    margin-bottom: var(--space-md);
    display: flex;
    justify-content: center;
  }

  .footer__love {
    font-family: var(--font-heading);
    font-size: 1.2rem;
    color: var(--color-primary-dark);
    margin-bottom: var(--space-sm);
  }

  .footer__copy {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin: 0;
  }
</style>
